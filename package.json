{
  "name": "@fg-lab/amadeus-core",
  "version": "0.2.0-alpha.5",
  "private": true,
  "description": "Unified modular Amadeus Core for DSH; development candidate",
  "license": "MIT",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "locale",
    "docs",
    "LICENSE",
    "NOTICE.md",
    "cordis.patch.yml"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "slots",
        "locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ]
    }
  },
  "engines": {
    "node": ">=22.13.0",
    "dsh": ">=0.2.1-rc.3 <0.3.0"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.3.0",
    "ajv": "8.20.0",
    "morphicons": "^1.7.1",
    "playwright-core": "1.58.2",
    "qrcode": "1.5.4"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-host-webserver": ">=0.1.0-rc.6 <0.2.0 || >=0.1.5-rc.0 <0.3.0 || >=0.2.0-rc.0 <0.3.0",
    "@deepseek-ai/dsh-llm": ">=0.1.0-rc.6 <0.2.0 || >=0.1.5-rc.0 <0.3.0 || >=0.2.0-rc.0 <0.3.0",
    "@deepseek-ai/dsh-system-prompt": ">=0.1.0-rc.6 <0.2.0 || >=0.1.5-rc.0 <0.3.0 || >=0.2.0-rc.0 <0.3.0",
    "@deepseek-ai/dsh-tools": ">=0.1.0-rc.6 <0.2.0 || >=0.1.5-rc.0 <0.3.0 || >=0.2.0-rc.0 <0.3.0",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "devDependencies": {
    "@deepseek-ai/schemastery": "3.18.5"
  },
  "scripts": {
    "build": "node scripts/build-client.mjs",
    "test": "node --test tests/*.test.js",
    "test:modules": "node scripts/test-modules.mjs",
    "pack:check": "node scripts/pack-check.mjs"
  }
}
